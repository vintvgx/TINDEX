{
  "name": "blog-generator-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "mobile"
  ],
  "scripts": {
    
    "mobile:start": "cd mobile && npm start",
    "mobile:android": "cd mobile && npm run android", 
    "mobile:ios": "cd mobile && npm run ios",
    "mobile:install": "cd mobile && npm install",
    
    "dev": "supabase start",
    "dev:functions": "supabase functions serve --env-file .env.local",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "deploy": "supabase functions deploy",
    "deploy:db": "supabase db push",
    "logs": "supabase functions logs",
    "generate": "supabase gen types typescript --local > shared/database.types.ts"
    
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
